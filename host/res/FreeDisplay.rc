#include <winres.h>
#include "../src/Resources.h"

IDI_APP ICON "FreeDisplay.ico"
1 RT_MANIFEST "FreeDisplay.manifest"

// Payload prepared by build.bat in out\payload.
IDR_APK          RCDATA "../out/payload/FreeDisplay.apk"
IDR_ADB          RCDATA "../out/payload/adb.exe"
IDR_ADBWINAPI    RCDATA "../out/payload/AdbWinApi.dll"
IDR_ADBWINUSBAPI RCDATA "../out/payload/AdbWinUsbApi.dll"
IDR_ADB_NOTICE   RCDATA "../out/payload/NOTICE.txt"

// Virtual Display Driver, unmodified and signed (MIT, see third_party/vdd).
IDR_VDD_INF      RCDATA "../third_party/vdd/MttVDD.inf"
IDR_VDD_DLL      RCDATA "../third_party/vdd/MttVDD.dll"
IDR_VDD_CAT      RCDATA "../third_party/vdd/MttVDD.cat"
IDR_VDD_LICENSE  RCDATA "../third_party/vdd/LICENSE.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FreeDisplay"
            VALUE "FileDescription", "FreeDisplay - use an Android tablet as a second monitor"
            VALUE "FileVersion", FD_VERSION_STR
            VALUE "InternalName", "FreeDisplay"
            VALUE "OriginalFilename", "FreeDisplay.exe"
            VALUE "ProductName", "FreeDisplay"
            VALUE "ProductVersion", FD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
